# Agent Console image: React app built with Node, served by FastAPI (uvicorn) on Cloud Run behind IAP.
# Built by infra/07_console.sh through infra/cloudbuild.yaml.

# --- 1. frontend --------------------------------------------------------------
FROM node:22-slim AS web
WORKDIR /web
COPY console/frontend/package.json console/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY console/frontend/ ./
RUN npm run build

# --- 2. API + static files ------------------------------------------------------
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TRIAGE_CONSOLE_DIST=/app/console/frontend/dist

WORKDIR /app
COPY requirements-runtime.txt requirements-console.txt ./
RUN pip install -r requirements-console.txt

COPY triage_agent/ triage_agent/
COPY config/ config/
COPY console/__init__.py console/__init__.py
COPY console/backend/ console/backend/
COPY --from=web /web/dist console/frontend/dist

RUN useradd --uid 10001 --no-create-home app
USER app

# Cloud Run sets PORT. IAP terminates TLS; trust its forwarding headers for request URLs.
CMD ["sh", "-c", "exec uvicorn console.backend.app:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers --forwarded-allow-ips='*'"]
