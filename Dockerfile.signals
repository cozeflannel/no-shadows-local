# slrr-signals (Cloud Run service): python -m slrr_signals.service serve --port 8080
# Built and deployed by infra/09_slrr_signals.sh through infra/cloudbuild.yaml.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY requirements-signals.txt .
RUN pip install -r requirements-signals.txt

COPY triage_agent/ triage_agent/
COPY slrr_signals/ slrr_signals/
COPY config/default_config.yaml config/distribution.yaml config/channel_owners.json config/signals.yaml config/

RUN useradd --uid 10001 --no-create-home app
USER app

CMD ["python", "-m", "slrr_signals.service", "serve", "--port", "8080"]
