FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY triage_agent/__init__.py triage_agent/__init__.py
COPY triage_agent/llm.py triage_agent/llm.py
COPY triage_agent/qa/__init__.py triage_agent/qa/__init__.py
COPY triage_agent/qa/record_key.py triage_agent/qa/record_key.py
COPY slrr_campaigns/ slrr_campaigns/
COPY config/campaigns.yaml config/campaigns.yaml

RUN pip install --no-deps --upgrade pip setuptools wheel && pip install .

RUN useradd --uid 10001 --no-create-home app
USER app

CMD ["python", "-m", "slrr_campaigns.service", "serve", "--port", "8080"]
